# The base data
numbers = [1, 2, 3]

# Doubles each number
my_list = [x * 2 for x in numbers]
print(my_list) 

# Maps a number to its square
my_dict = {x: x**2 for x in numbers}
print(my_dict) 

# Extracts unique numbers
duplicate_numbers = [1, 2, 2, 3]
my_set = {x for x in duplicate_numbers}
print(my_set)  
